generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/cyber_swarm/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model HighScore {
  id        String   @id @default(cuid())
  name      String
  kills     Int
  time      Int      // seconds survived
  character String
  level     Int
  createdAt DateTime @default(now())

  @@index([kills(sort: Desc)])
}
