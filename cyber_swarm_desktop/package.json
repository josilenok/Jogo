{
  "name": "cyber-swarm",
  "productName": "Cyber Swarm",
  "version": "1.0.0",
  "description": "CYBER SWARM — Roguelike Bullet-Heaven cyberpunk",
  "author": "Cyber Swarm Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-packager . \"Cyber Swarm\" --platform=win32 --arch=x64 --out=dist --overwrite --app-version=1.0.0",
    "pack:mac": "electron-packager . \"Cyber Swarm\" --platform=darwin --arch=x64 --out=dist --overwrite --app-version=1.0.0",
    "pack:linux": "electron-packager . \"Cyber Swarm\" --platform=linux --arch=x64 --out=dist --overwrite --app-version=1.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.0.0"
  }
}
